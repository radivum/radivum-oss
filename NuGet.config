<?xml version="1.0" encoding="utf-8"?>
<!--
  One source, and it is public. Clearing the inherited sources is what makes the standalone build a proof
  rather than a courtesy: a build here cannot reach a private feed even if the machine running it can.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
