<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Radivum.Oss.Commands\Radivum.Oss.Commands.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>radivum-oss</AssemblyName>
    <PackageId>radivum-oss</PackageId>
    <Description>Collect and document an Azure network from your own sign-in: a versioned snapshot, Level 1 configuration findings, a Markdown report and a Mermaid topology, uploaded nowhere.</Description>
    <PackageTags>azure;networking;cli;inventory;reporting;dotnet-tool</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--
      Installed as a .NET tool so the OSS edition is a single command, radivum-oss, with no separate
      install step (requirements section 4.1). The tool install command resolves this package from the
      OSS feed, and the whole product travels in it, so the OSS user installs nothing else.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>radivum-oss</ToolCommandName>
  </PropertyGroup>

</Project>